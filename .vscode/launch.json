  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "system-service",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": ["run", "start:system"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "restart": true,
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**", "node_modules/**"],
      "autoAttachChildProcesses": true
    },
  ]
}
