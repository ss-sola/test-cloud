{
  "name": "system-service",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "oxfmt --write \"src/**/*.ts\" \"src/__tests__/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src src/__tests__ -A expect-expect -- --fix",
    "test": "vitest run --config ../../scripts/vitest.backend.unit.config.ts",
    "test:watch": "vitest watch --config ../../scripts/vitest.backend.unit.config.ts",
    "test:cov": "vitest run --coverage --config ../../scripts/vitest.backend.unit.config.ts",
    "test:debug": "vitest run --inspectBrk --config ../../scripts/vitest.backend.unit.config.ts --no-file-parallelism",
    "test:e2e": "vitest run --config ../../scripts/vitest.backend.e2e.config.ts"
  },
  "dependencies": {
    "@nest-cloud/common": "file:../common-service",
    "@nestjs/serve-static": "^5.0.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.23",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.33",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/supertest": "^7.2.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
