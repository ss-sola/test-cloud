{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "watchAssets": true,
    "assets": [
      {
        "include": "../public/**/*.{html,js,css,svg,png,jpg,jpeg,gif,webp,avif,ico,json,txt,map,woff,woff2,ttf,otf}",
        "exclude": "../public/**/*.tmp.*",
        "outDir": "dist/public"
      }
    ]
  }
}
